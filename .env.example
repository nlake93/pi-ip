# Web server port (the UI is served here)
PORT=8080

# A long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-in-production

# RTSP port MediaMTX listens on
RTSP_PORT=8554

# HLS port MediaMTX listens on
HLS_PORT=8888

# WebRTC port MediaMTX listens on
WEBRTC_PORT=8889

# Full path to the mediamtx binary
MEDIAMTX_BIN=/usr/local/bin/mediamtx

# Path where the generated mediamtx.yml is written
# Defaults to config/mediamtx.yml inside the project directory
# MEDIAMTX_CONFIG=/home/pi/pi-ip/config/mediamtx.yml

# Path where camera settings are persisted
# Defaults to config/settings.json inside the project directory
# SETTINGS_FILE=/home/pi/pi-ip/config/settings.json

# Path where the hashed admin credentials are stored
# Defaults to config/auth.json inside the project directory
# AUTH_FILE=/home/pi/pi-ip/config/auth.json
