<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-body">
<div class="login-wrap">
  <div class="login-card">
    <div class="login-logo">
      <svg class="login-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="12" r="3.5"/>
        <path d="M20.9 12a8.9 8.9 0 1 1-17.8 0 8.9 8.9 0 0 1 17.8 0z"/>
        <path d="M2 9h2M20 9h2M12 2v2M12 20v2"/>
      </svg>
      <h1>pi-ip</h1>
      <p class="login-subtitle">Raspberry Pi IP Camera</p>
    </div>

    <% if (needsSetup) { %>
    <div class="alert alert-warning">
      No credentials found. Run <code>npm run set-password</code> on the Pi first.
    </div>
    <% } %>

    <% if (error === 'invalid') { %>
    <div class="alert alert-error">Incorrect username or password.</div>
    <% } %>

    <form action="/login" method="POST" class="login-form">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" required autocomplete="username" autofocus>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-primary btn-full">Sign in</button>
    </form>
  </div>
</div>
<script src="/js/app.js"></script>
</body>
</html>
