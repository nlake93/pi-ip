<%- include('partials/header') %>

<div class="page-header">
  <div>
    <h2>Dashboard</h2>
    <p class="text-muted">Live preview and camera settings</p>
  </div>
</div>

<% if (saved) { %>
<div class="alert alert-success">&#10003; Settings saved — stream restarted.</div>
<% } %>
<% if (error) { %>
<div class="alert alert-error">Failed to apply settings. Check that MediaMTX is installed and the camera is connected.</div>
<% } %>

<div class="dashboard-layout">

  <%# ══ LEFT — stream preview + URLs (sticky) ══ %>
  <div class="dashboard-left">

    <div class="card card-stream">
      <div class="card-header">
        <h3>Live Preview <span class="text-muted text-sm">(WebRTC)</span></h3>
      </div>
      <div class="card-body p-0">
        <div class="video-wrap">
          <video id="livePlayer" autoplay muted playsinline controls></video>
          <div class="video-placeholder" id="videoPlaceholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="12" r="3"/><path d="M20.9 12a8.9 8.9 0 1 1-17.8 0 8.9 8.9 0 0 1 17.8 0z"/></svg>
            <p>Stream loading…</p>
          </div>
        </div>
      </div>
    </div>

    <div class="card" style="margin-top:1.25rem">
      <div class="card-header"><h3>Stream URLs</h3></div>
      <div class="card-body">
        <div class="url-list">

          <div class="url-item">
            <label>RTSP <span class="text-muted">(VLC, Home Assistant, NVR…)</span></label>
            <div class="url-copy-row">
              <code id="url-rtsp"><%= rtspUrl %></code>
              <button class="btn-copy" data-target="url-rtsp" title="Copy">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
            </div>
          </div>

          <div class="url-item">
            <label>WebRTC <span class="text-muted">(low-latency browser)</span></label>
            <div class="url-copy-row">
              <code id="url-webrtc"><%= webrtcUrl %></code>
              <button class="btn-copy" data-target="url-webrtc" title="Copy">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div class="card" style="margin-top:1.25rem">
      <div class="card-header"><h3>Software</h3></div>
      <div class="card-body">
        <div id="update-status"></div>
        <div style="margin-top:0.75rem;display:flex;gap:0.5rem;flex-wrap:wrap">
          <button id="btn-check-update" class="btn btn-secondary">Check for updates</button>
          <button id="btn-install-update" class="btn btn-primary" style="display:none">Install update</button>
        </div>
      </div>
    </div>

  </div>

  <%# ══ RIGHT — camera settings (scrolls) ══ %>
  <div class="dashboard-right">
    <form action="/settings" method="POST" class="settings-form" id="settingsForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="settings-heading">
        <h3>Camera Settings</h3>
        <p class="text-muted">Changes restart the stream immediately.</p>
      </div>

      <div class="settings-grid">

      <%# ── Video ── %>
      <div class="card settings-section settings-card-full">
        <div class="card-header"><h3>Video</h3></div>
        <div class="card-body">

          <div class="form-row form-row-3col">
            <div class="form-group">
              <label for="resolution">Resolution preset</label>
              <select id="resolution" name="resolution">
                <% [
                  [1920,1080,'1080p (Full HD)'],
                  [1280,720, '720p (HD)'],
                  [1024,768, '768p (4:3)'],
                  [800,600,  '600p (4:3)'],
                  [640,480,  '480p (VGA)'],
                ].filter(([w,h]) => w <= capabilities.maxWidth && h <= capabilities.maxHeight)
                 .forEach(([w,h,label]) => { %>
                <option value="<%= w %>x<%= h %>"
                  <%= settings.width === w && settings.height === h ? 'selected' : '' %>>
                  <%= w %>&times;<%= h %> — <%= label %>
                </option>
                <% }) %>
              </select>
              <input type="hidden" id="width"  name="width"  value="<%= settings.width %>">
              <input type="hidden" id="height" name="height" value="<%= settings.height %>">
            </div>

            <div class="form-group">
              <label for="fps">Framerate</label>
              <select id="fps" name="fps">
                <% [10,15,24,25,30,50,60].forEach(v => { %>
                <option value="<%= v %>" <%= settings.fps === v ? 'selected' : '' %>><%= v %> fps</option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label for="bitrate">Bitrate</label>
              <select id="bitrate" name="bitrate">
                <% [
                  [500000,  '0.5 Mbps'],
                  [1000000, '1 Mbps'],
                  [2000000, '2 Mbps'],
                  [4000000, '4 Mbps'],
                  [6000000, '6 Mbps'],
                  [8000000, '8 Mbps'],
                ].forEach(([v,label]) => { %>
                <option value="<%= v %>" <%= settings.bitrate === v ? 'selected' : '' %>><%= label %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label for="profile">H.264 profile</label>
              <select id="profile" name="profile">
                <% ['baseline','main','high'].forEach(p => { %>
                <option value="<%= p %>" <%= settings.profile === p ? 'selected' : '' %>><%= p.charAt(0).toUpperCase()+p.slice(1) %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label for="level">H.264 level</label>
              <select id="level" name="level">
                <% ['4','4.1','4.2'].forEach(l => { %>
                <option value="<%= l %>" <%= String(settings.level) === l ? 'selected' : '' %>><%= l %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label for="idr">Keyframe interval <span class="text-muted text-sm">(frames)</span></label>
              <input type="number" id="idr" name="idr" value="<%= settings.idr %>" min="1" max="300" step="1">
            </div>
          </div>

        </div>
      </div>

      <%# ── Image ── %>
      <div class="card settings-section">
        <div class="card-header"><h3>Image</h3></div>
        <div class="card-body">
          <div class="form-row">

            <% [
              ['brightness',    'Brightness',        -1, 1,   0.05, settings.brightness],
              ['contrast',      'Contrast',           0, 4,   0.05, settings.contrast],
              ['saturation',    'Saturation',         0, 4,   0.05, settings.saturation],
              ['sharpness',     'Sharpness',          0, 4,   0.05, settings.sharpness],
              ['exposureValue', 'Exposure comp (EV)', -8, 8,  0.5,  settings.exposureValue],
            ].forEach(([name, label, min, max, step, val]) => { %>
            <div class="form-group form-group-slider">
              <label for="<%= name %>"><%= label %></label>
              <div class="slider-row">
                <input type="range" id="<%= name %>" name="<%= name %>"
                  min="<%= min %>" max="<%= max %>" step="<%= step %>" value="<%= val %>">
                <output for="<%= name %>" class="slider-value"><%= val %></output>
              </div>
            </div>
            <% }) %>

          </div>
        </div>
      </div>

      <%# ── Exposure & WB + Orientation stacked in one column ── %>
      <div class="settings-stack">

        <div class="card settings-section">
          <div class="card-header"><h3>Exposure &amp; White Balance</h3></div>
          <div class="card-body">
            <div class="form-row">

              <div class="form-group">
                <label for="exposureMode">Exposure mode</label>
                <select id="exposureMode" name="exposureMode">
                  <% ['normal','short','long','custom'].forEach(m => { %>
                  <option value="<%= m %>" <%= settings.exposureMode === m ? 'selected' : '' %>><%= m.charAt(0).toUpperCase()+m.slice(1) %></option>
                  <% }) %>
                </select>
              </div>

              <div class="form-group">
                <label for="awbMode">Auto white balance</label>
                <select id="awbMode" name="awbMode">
                  <% ['auto','incandescent','tungsten','fluorescent','indoor','daylight','cloudy'].forEach(m => { %>
                  <option value="<%= m %>" <%= settings.awbMode === m ? 'selected' : '' %>><%= m.charAt(0).toUpperCase()+m.slice(1) %></option>
                  <% }) %>
                </select>
              </div>

            </div>
          </div>
        </div>

        <div class="card settings-section">
          <div class="card-header"><h3>Orientation</h3></div>
          <div class="card-body">
            <div class="form-row">

              <div class="form-group form-group-check">
                <label class="checkbox-label">
                  <input type="checkbox" name="hFlip" <%= settings.hFlip ? 'checked' : '' %>>
                  <span>Horizontal flip</span>
                </label>
              </div>

              <div class="form-group form-group-check">
                <label class="checkbox-label">
                  <input type="checkbox" name="vFlip" <%= settings.vFlip ? 'checked' : '' %>>
                  <span>Vertical flip</span>
                </label>
              </div>

            </div>
          </div>
        </div>

      </div><%# /settings-stack %>

      <%# ── Focus (autofocus cameras only) ── %>
      <% if (capabilities.hasAF) { %>
      <div class="card settings-section settings-card-full">
        <div class="card-header"><h3>Focus</h3></div>
        <div class="card-body">
          <div class="form-row">

            <div class="form-group">
              <label for="afMode">AF mode</label>
              <select id="afMode" name="afMode">
                <% ['auto','manual','continuous'].forEach(m => { %>
                <option value="<%= m %>" <%= settings.afMode === m ? 'selected' : '' %>><%= m.charAt(0).toUpperCase()+m.slice(1) %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label for="afRange">AF range</label>
              <select id="afRange" name="afRange">
                <% ['normal','macro','full'].forEach(m => { %>
                <option value="<%= m %>" <%= settings.afRange === m ? 'selected' : '' %>><%= m.charAt(0).toUpperCase()+m.slice(1) %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label for="afSpeed">AF speed</label>
              <select id="afSpeed" name="afSpeed">
                <% ['normal','fast'].forEach(m => { %>
                <option value="<%= m %>" <%= settings.afSpeed === m ? 'selected' : '' %>><%= m.charAt(0).toUpperCase()+m.slice(1) %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group form-group-slider">
              <label for="lensPosition">Lens position <span class="text-muted text-sm">(manual AF only)</span></label>
              <div class="slider-row">
                <input type="range" id="lensPosition" name="lensPosition"
                  min="0" max="10" step="0.1" value="<%= settings.lensPosition %>">
                <output for="lensPosition" class="slider-value"><%= settings.lensPosition %></output>
              </div>
            </div>

          </div>
        </div>
      </div>
      <% } %>

      </div><%# /settings-grid %>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save &amp; restart stream</button>
        <button type="reset"  class="btn btn-secondary">Reset</button>
      </div>

    </form>
  </div>

</div>

<script>
  window.PI_IP_WEBRTC_URL = '<%= webrtcUrl %>';
</script>

<script>
(function () {
  const btnCheck   = document.getElementById('btn-check-update');
  const btnInstall = document.getElementById('btn-install-update');
  const statusEl   = document.getElementById('update-status');

  btnCheck.addEventListener('click', async () => {
    btnCheck.disabled = true;
    btnCheck.textContent = 'Checking…';
    try {
      const res  = await fetch('/update/check');
      const data = await res.json();
      if (!res.ok) {
        statusEl.innerHTML = '<span style="color:var(--color-error,#c0392b)">Check failed: ' + (data.detail || data.error) + '</span>';
        btnInstall.style.display = 'none';
      } else if (data.upToDate) {
        statusEl.innerHTML =
          '<span style="color:var(--color-success,#27ae60)">&#10003; Up to date</span>' +
          ' <span class="text-muted text-sm">(' + data.current.slice(0, 7) + ')</span>';
        btnInstall.style.display = 'none';
      } else {
        statusEl.innerHTML =
          '<span style="color:var(--color-warning,#e67e22)">&#8593; Update available</span>' +
          ' <span class="text-muted text-sm">' + data.current.slice(0, 7) + ' &rarr; ' + data.latest.slice(0, 7) + '</span>';
        btnInstall.style.display = '';
      }
    } catch (e) {
      statusEl.innerHTML = '<span style="color:var(--color-error,#c0392b)">Check failed &mdash; is the Pi online?</span>';
    }
    btnCheck.disabled = false;
    btnCheck.textContent = 'Check for updates';
  });

  btnInstall.addEventListener('click', async () => {
    if (!confirm('Install update and restart the stream? The page will reload automatically.')) return;
    btnInstall.disabled = true;
    btnCheck.disabled   = true;
    btnInstall.textContent = 'Installing…';
    statusEl.innerHTML = '<span class="text-muted text-sm">Pulling latest code and restarting&hellip;</span>';

    let updateOk = false;
    try {
      const res  = await fetch('/update', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        statusEl.innerHTML = '<span style="color:var(--color-error,#c0392b)">Update failed: ' + (data.detail || data.error || res.status) + '</span>';
        btnInstall.disabled = false;
        btnCheck.disabled   = false;
        btnInstall.textContent = 'Install update';
        return;
      }
      updateOk = true;
    } catch { /* expected — server exits to restart */ }

    if (!updateOk) {
      // Server exited mid-response (normal) — proceed with countdown
    }

    statusEl.innerHTML = '<span style="color:var(--color-success,#27ae60)">&#10003; Updated! Page will reload shortly&hellip;</span>';
    setTimeout(() => location.reload(), 20000);
  });
}());
</script>

<%- include('partials/footer') %>
