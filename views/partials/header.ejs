<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% if (typeof username !== 'undefined') { %>
<nav class="navbar">
  <a href="/" class="navbar-brand">
    <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M20.9 12a8.9 8.9 0 1 1-17.8 0 8.9 8.9 0 0 1 17.8 0z"/><path d="M2 9h2M20 9h2M12 2v2M12 20v2"/></svg>
    <span>pi-ip</span>
  </a>
  <ul class="navbar-links">
    <li><a href="/"         class="<%= currentPage === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
    <li><a href="/settings" class="<%= currentPage === 'settings'  ? 'active' : '' %>">Settings</a></li>
  </ul>
  <div class="navbar-user">
    <span class="navbar-username"><%= username %></span>
    <form action="/logout" method="POST">
      <button type="submit" class="btn-logout">Sign out</button>
    </form>
  </div>
</nav>
<% } %>
<main class="container">
